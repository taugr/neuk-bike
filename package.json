{
  "name": "neuk-bike",
  "version": "0.1.0",
  "private": true,
  "description": "Static mobile-friendly map for finding nearby cycle parking across the UK, Ireland, Spain and Armenia.",
  "keywords": [
    "active-travel",
    "armenia",
    "cycle-parking",
    "cycling",
    "edinburgh",
    "england",
    "ireland",
    "scotland",
    "spain",
    "wales",
    "map",
    "nextjs"
  ],
  "homepage": "https://neuk.bike",
  "bugs": {
    "url": "https://github.com/taugr/neuk-bike/issues"
  },
  "license": "MIT",
  "author": "Tom Auger <tom@tau.gr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/neuk-bike.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy out --project-name neuk-bike --branch main",
    "start": "next start",
    "update:data": "node scripts/refresh-data-release.mjs parking",
    "update:network": "node scripts/refresh-data-release.mjs network",
    "update:pois": "node scripts/refresh-data-release.mjs pois",
    "verify:network": "node scripts/verify-cycle-network-data.mjs",
    "verify:pois": "node scripts/verify-cycling-poi-data.mjs",
    "verify:data": "node scripts/verify-cycle-parking-data.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "prepare": "node scripts/prepare.mjs",
    "refresh:data": "node scripts/refresh-data-release.mjs all",
    "check:data": "node scripts/check-data-freshness.mjs",
    "test:analytics": "playwright test --config playwright.analytics.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.10.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "posthog-js": "^1.434.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "osm-pbf-parser-node": "1.1.4",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "4.140.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
