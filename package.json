{
  "name": "neuk-bike",
  "version": "0.1.0",
  "private": true,
  "description": "Static mobile-friendly map for finding nearby cycle parking across the UK, Ireland, Spain and Armenia.",
  "keywords": [
    "active-travel",
    "armenia",
    "cycle-parking",
    "cycling",
    "edinburgh",
    "england",
    "ireland",
    "scotland",
    "spain",
    "wales",
    "map",
    "nextjs"
  ],
  "homepage": "https://neuk.bike",
  "bugs": {
    "url": "https://github.com/taugr/neuk-bike/issues"
  },
  "license": "MIT",
  "author": "Tom Auger <tom@tau.gr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/neuk-bike.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "preview:parking-models": "node scripts/preview-parking-models.mjs",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "build": "next build",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy out --project-name neuk-bike --branch main",
    "start": "next start",
    "update:data": "node scripts/refresh-data-release.mjs parking",
    "update:network": "node scripts/refresh-data-release.mjs network",
    "update:pois": "node scripts/refresh-data-release.mjs pois",
    "verify:network": "node scripts/verify-cycle-network-data.mjs",
    "verify:pois": "node scripts/verify-cycling-poi-data.mjs",
    "verify:data": "node scripts/verify-cycle-parking-data.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "prepare": "node scripts/prepare.mjs",
    "refresh:data": "node scripts/refresh-data-release.mjs all",
    "check:data": "node scripts/check-data-freshness.mjs",
    "test:analytics": "playwright test --config playwright.analytics.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.69.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.9.1",
    "next": "^16.4.5",
    "posthog-js": "^1.447.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "osm-pbf-parser-node": "1.1.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.161.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
