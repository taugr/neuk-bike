{
  "name": "neuk-bike",
  "version": "0.1.0",
  "private": true,
  "description": "Static mobile-friendly map for finding nearby cycle parking across the UK, Ireland, Spain and Armenia.",
  "keywords": [
    "active-travel",
    "armenia",
    "cycle-parking",
    "cycling",
    "edinburgh",
    "england",
    "ireland",
    "scotland",
    "spain",
    "wales",
    "map",
    "nextjs"
  ],
  "homepage": "https://neuk.bike",
  "bugs": {
    "url": "https://github.com/taugr/neuk-bike/issues"
  },
  "license": "MIT",
  "author": "Tom Auger <tom@tau.gr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taugr/neuk-bike.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy out --project-name neuk-bike --branch main",
    "start": "next start",
    "update:data": "node scripts/update-cycle-parking-data.mjs",
    "update:network": "node scripts/update-cycle-network-data.mjs",
    "update:pois": "node scripts/update-cycling-poi-data.mjs",
    "verify:network": "node scripts/verify-cycle-network-data.mjs",
    "verify:pois": "node scripts/verify-cycling-poi-data.mjs",
    "verify:data": "node scripts/verify-cycle-parking-data.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "lint": "oxlint -c oxlint.json .",
    "lint:fix": "oxlint -c oxlint.json . --fix",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.2.0",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "posthog-js": "^1.414.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "osm-pbf-parser-node": "1.1.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
